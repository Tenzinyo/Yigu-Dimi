---
// Client-side theme toggle. The inline script in BaseHead already applies
// any stored preference before paint; this button just flips + persists it.
---

<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle dark mode">
  <span class="icon icon-sun" aria-hidden="true">☀</span>
  <span class="icon icon-moon" aria-hidden="true">☾</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border: var(--panel-border-width) solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    color: var(--text);
    cursor: pointer;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .theme-toggle:hover {
    background: var(--accent-soft);
  }

  .icon-moon {
    display: none;
  }

  :root[data-theme='dark'] .icon-sun {
    display: none;
  }

  :root[data-theme='dark'] .icon-moon {
    display: inline;
  }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var root = document.documentElement;
      var current = root.getAttribute('data-theme');
      var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      var isDark = current ? current === 'dark' : prefersDark;
      var next = isDark ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch (e) {}
    });
  })();
</script>
