---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';

export async function getStaticPaths() {
  const entries = await getCollection('art', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'art'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const dateLabel = entry.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.caption ?? entry.data.title}
  image={entry.data.image}
  type="article"
>
  <article class="wrap post">
    <a href="/art/" class="post__back">&larr; All art</a>

    <header class="panel post__header speed-lines">
      <span class="badge badge-art">Art</span>
      <h1>{entry.data.title}</h1>
      <time datetime={entry.data.date.toISOString()} class="post__date">{dateLabel}</time>
      <TagList tags={entry.data.tags} />
    </header>

    <img class="post__cover" src={entry.data.image} alt={entry.data.imageAlt} />

    {entry.data.caption && <p class="art-caption">{entry.data.caption}</p>}

    <div class="panel-flat post__body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding-block: 2rem 3rem;
    max-width: 800px;
  }

  .post__back {
    display: inline-block;
    margin-bottom: 1.25rem;
    font-weight: 600;
    text-decoration: none;
  }

  .post__header {
    padding: 1.75rem 1.75rem 1.5rem;
    margin-bottom: 1.5rem;
  }

  .post__header h1 {
    margin-top: 0.5rem;
  }

  .post__date {
    display: block;
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .post__cover {
    width: 100%;
    max-height: 640px;
    object-fit: contain;
    background: var(--bg-inset);
    border: var(--panel-border-width) solid var(--border);
    border-radius: var(--radius);
    margin-bottom: 1rem;
  }

  .art-caption {
    color: var(--text-muted);
    font-style: italic;
    margin-bottom: 1.5rem;
  }

  .post__body {
    padding: 1.75rem 2rem 2.25rem;
  }

  .post__body:empty {
    display: none;
  }
</style>
