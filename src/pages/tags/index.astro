---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getFeed, getAllTags } from '../../utils/content';

const feed = await getFeed();
const tags = getAllTags(feed);

const counts = new Map<string, number>();
for (const item of feed) {
  for (const tag of item.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}
---

<BaseLayout title="Tags" description="Browse everything on Yigu Dimi by tag.">
  <section class="wrap page-section">
    <h1>Tags</h1>
    {tags.length > 0 ? (
      <ul class="tag-cloud">
        {tags.map((tag) => (
          <li>
            <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>
              {tag} <span class="tag-count">({counts.get(tag)})</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-state">No tags yet.</p>
    )}
  </section>
</BaseLayout>

<style>
  .page-section {
    padding-block: 2.5rem 3rem;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }

  .tag-count {
    opacity: 0.75;
    font-size: 0.85em;
  }

  .empty-state {
    color: var(--text-muted);
  }
</style>
